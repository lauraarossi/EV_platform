# Local dev. In production (e.g. Railway) this is injected by the Postgres
# addon as postgresql://… — app.config rewrites it to the psycopg3 driver.
DATABASE_URL=postgresql+psycopg://evuser:evpass@localhost:5432/ev_platform
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API. Only matters in
# local development, where Vite serves the page on another port: in production
# the same process serves both the app and the API, so nothing is cross-origin.
# List the deployed hostnames anyway, so a browser pointed at the API from
# elsewhere behaves predictably.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://eevie.ie

# External API keys (add as integrated)
OPENWEATHER_API_KEY=
FUEL_PRICE_API_KEY=

# Accounts. SECRET_KEY signs session cookies — changing it signs everyone out.
# Leave GOOGLE_CLIENT_ID empty to hide the Google button entirely. It is the
# "...apps.googleusercontent.com" string from a Web application OAuth client,
# and it is public — the browser sends it to Google.
#
# The origin serving the app must be listed under that client's "Authorised
# JavaScript origins", or Google refuses to render the button: add
# http://localhost:5173 for local work, and your deployed URL alongside it.
GOOGLE_CLIENT_ID=
# Not needed: the browser receives a signed ID token which the server verifies
# against Google's public keys, so there is no code exchange and no secret.
GOOGLE_CLIENT_SECRET=
# Set to false once your account exists, to stop anyone else signing up.
ALLOW_REGISTRATION=true

# Comma-separated emails granted the admin role, which unlocks the Admin tab:
# data refreshes, catalogue health and account roles. This is how the first
# admin comes to exist on a hosted deployment, where there is no shell to
# promote an account from. Listing an email only ever grants the role — remove
# it here and nothing changes, so a typo cannot lock you out. Demote from the
# console instead.
ADMIN_EMAILS=

# Optional blunt shared password in front of everything (separate from accounts).
APP_PASSWORD=

# Grams of CO2 per kWh from the grid, used to put an EV's emissions on the
# same footing as a petrol car's. Varies by country and falls year on year;
# replace the default with a current published figure for your grid.
GRID_CO2_G_PER_KWH=250
