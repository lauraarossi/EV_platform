# Local dev. In production (e.g. Railway) this is injected by the Postgres
# addon as postgresql://… — app.config rewrites it to the psycopg3 driver.
DATABASE_URL=postgresql+psycopg://evuser:evpass@localhost:5432/ev_platform
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External API keys (add as integrated)
OPENWEATHER_API_KEY=
FUEL_PRICE_API_KEY=

# Accounts. SECRET_KEY signs session cookies — changing it signs everyone out.
# Leave GOOGLE_CLIENT_ID empty to hide the Google button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to false once your account exists, to stop anyone else signing up.
ALLOW_REGISTRATION=true

# Comma-separated emails granted the admin role, which unlocks the Admin tab:
# data refreshes, catalogue health and account roles. This is how the first
# admin comes to exist on a hosted deployment, where there is no shell to
# promote an account from. Listing an email only ever grants the role — remove
# it here and nothing changes, so a typo cannot lock you out. Demote from the
# console instead.
ADMIN_EMAILS=

# Optional blunt shared password in front of everything (separate from accounts).
APP_PASSWORD=
